# API URL - Change this to your Railway backend URL in production
VITE_API_URL=http://localhost:3001/api

# Anti-SSRF: Bloquea peticiones a IPs privadas/localhost desde el cliente
# Activar en producción (red municipal). Desactivar en desarrollo local.
VITE_ENABLE_STRICT_LOCAL_NETWORK_BLOCK=false

# ============ TENANT (Municipalidad) ============
# Obligatorio en produccion. Define la identidad visual y textual.
VITE_TENANT_COMMUNE_NAME=Renca
VITE_TENANT_MUNICIPALITY_NAME=Municipalidad de Renca
VITE_TENANT_MUNICIPALITY_FULL_NAME=Ilustre Municipalidad de Renca
VITE_TENANT_PLATFORM_NAME=Comunidad Social Renca
VITE_TENANT_PLATFORM_SHORT_NAME=Comunidad Renca
VITE_TENANT_ADMIN_EMAIL=admin@renca.cl
VITE_TENANT_WEBSITE=www.renca.cl
VITE_TENANT_ADDRESS=Blanco Encalada 1335, Renca
VITE_TENANT_LOGO_PATH=/icons/logo.png
# VITE_TENANT_COLOR_PRIMARY=#2563eb
# VITE_TENANT_COLOR_SECONDARY=#10b981
# VITE_TENANT_DISSOLUTION_ENTITY=Corporación Municipal de Renca
