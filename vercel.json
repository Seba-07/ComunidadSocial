{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/auth.html",
      "destination": "/app/login",
      "statusCode": 301
    },
    {
      "source": "/ministro-login.html",
      "destination": "/app/login",
      "statusCode": 301
    },
    {
      "source": "/ministro-dashboard.html",
      "destination": "/app/ministro",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://comunidadsocial-production.up.railway.app/api/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "/react-app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
