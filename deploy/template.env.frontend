# ============================================================
# Template de variables de entorno — Frontend (Vercel)
# Copiar y completar para cada nueva municipalidad
# ============================================================

# --- API ---
VITE_API_URL=https://cs-<COMUNA>-api-production.up.railway.app/api

# --- Tenant (Municipalidad) ---
VITE_TENANT_COMMUNE_NAME=<NombreComuna>
VITE_TENANT_MUNICIPALITY_NAME=Municipalidad de <NombreComuna>
VITE_TENANT_MUNICIPALITY_FULL_NAME=Ilustre Municipalidad de <NombreComuna>
VITE_TENANT_PLATFORM_NAME=Comunidad Social <NombreComuna>
VITE_TENANT_PLATFORM_SHORT_NAME=Comunidad <NombreComuna>
VITE_TENANT_ADMIN_EMAIL=admin@<comuna>.cl
VITE_TENANT_WEBSITE=www.<comuna>.cl
VITE_TENANT_ADDRESS=<Direccion completa>
VITE_TENANT_LOGO_PATH=/icons/logo.png
# VITE_TENANT_COLOR_PRIMARY=#2563eb
# VITE_TENANT_COLOR_SECONDARY=#10b981
# VITE_TENANT_DISSOLUTION_ENTITY=Corporacion Municipal de <NombreComuna>

# --- Anti-SSRF ---
VITE_ENABLE_STRICT_LOCAL_NETWORK_BLOCK=true
