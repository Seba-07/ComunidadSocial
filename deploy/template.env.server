# ============================================================
# Template de variables de entorno — Backend (Railway)
# Copiar y completar para cada nueva municipalidad
# ============================================================

# --- Base de datos ---
MONGODB_URI=mongodb+srv://cs_<COMUNA>_user:<PASSWORD>@comunidadsocial.ebklrle.mongodb.net/cs_<COMUNA>?appName=ComunidadSocial

# --- Auth ---
JWT_SECRET=<GENERAR_STRING_ALEATORIO_64_CHARS>

# --- Entorno ---
NODE_ENV=production
PORT=3001

# --- CORS ---
FRONTEND_URL=https://cs-<COMUNA>.vercel.app
# FRONTEND_URL_ALT=https://www.dominio-custom.cl

# --- Tenant (Municipalidad) ---
TENANT_COMMUNE_NAME=<NombreComuna>
TENANT_MUNICIPALITY_NAME=Municipalidad de <NombreComuna>
TENANT_MUNICIPALITY_FULL_NAME=Ilustre Municipalidad de <NombreComuna>
TENANT_REGION_NAME=Metropolitana
TENANT_ADDRESS=<Direccion completa de la municipalidad>
TENANT_PHONE=<Telefono>
TENANT_WEBSITE=www.<comuna>.cl
TENANT_ADMIN_EMAIL=admin@<comuna>.cl
TENANT_PLATFORM_NAME=Comunidad Social <NombreComuna>
TENANT_PLATFORM_SHORT_NAME=Comunidad <NombreComuna>
# TENANT_PDF_HEADER=REPUBLICA DE CHILE - I. MUNICIPALIDAD DE <COMUNA_MAYUS>
# TENANT_PDF_SUBTITLE=SECRETARIA MUNICIPAL
# TENANT_DISSOLUTION_ENTITY=Corporacion Municipal de <NombreComuna>

# --- AWS S3 (opcional, docs en base64 por defecto) ---
# AWS_S3_BUCKET=cs-<comuna>-docs
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Anti-SSRF ---
ENABLE_STRICT_LOCAL_NETWORK_BLOCK=true
