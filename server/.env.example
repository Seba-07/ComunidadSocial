# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/comunidad_social?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Frontend URL for CORS
FRONTEND_URL=https://your-app.vercel.app

# Port (Railway will set this automatically)
PORT=3001

# Environment
NODE_ENV=production

# Anti-SSRF: Bloquea peticiones salientes a IPs privadas/localhost
# Activar en producción (red municipal). Desactivar en desarrollo local.
ENABLE_STRICT_LOCAL_NETWORK_BLOCK=false
